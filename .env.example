# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA debe commitearse (CLAUDE.md §3 R5).

# ---------------------------------------------------------------------------
# Proveedor de LLM  (D-011: capa intercambiable, ver src/supportops/llm.py)
#   openai  → funciona hoy
#   bedrock → cuando haya acceso; requiere `uv sync --extra bedrock`
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# IDs de modelo. NO los inventes: verifícalos con
#   uv run python -m scripts.spike_llm
# y anota los elegidos en BITACORA.md → "Versiones verificadas".
#
# D-002: el juez DEBE ser un modelo distinto y más capaz que el agente.
# Usar el mismo introduce sesgo de auto-preferencia y arruina task completion.
OPENAI_AGENT_MODEL=
OPENAI_JUDGE_MODEL=

# --- Amazon Bedrock (aún sin acceso; listo para migrar) ---
AWS_REGION=us-east-1
# BEDROCK_AGENT_MODEL=anthropic.claude-sonnet-5
# BEDROCK_JUDGE_MODEL=anthropic.claude-opus-5

# ---------------------------------------------------------------------------
# Observabilidad — LangSmith
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=supportops-agent

# ---------------------------------------------------------------------------
# Agente
# ---------------------------------------------------------------------------
# Corta bucles infinitos: al superarlo, el nodo GUARDA escala a humano.
MAX_AGENT_STEPS=8

# ---------------------------------------------------------------------------
# Evaluación
# ---------------------------------------------------------------------------
# K del protocolo de medición: los gates se aplican a la MEDIA de K corridas,
# nunca a una sola (el sistema no es determinista — ver BITACORA.md P-003).
EVAL_RUNS_PER_TICKET=3

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# D-012 — CANARY BUILD. Expone `customer_id` al LLM a propósito para MEDIR
# cuántas veces intenta un acceso cruzado cuando se le da la oportunidad.
# SOLO para la suite de red teaming. Jamás en producción ni por defecto.
INSECURE_CANARY=false
